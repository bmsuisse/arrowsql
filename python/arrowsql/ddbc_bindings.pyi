"""Type stub for the compiled extension ``mssql_python.ddbc_bindings`` (RUST-PORT).

Covers the port-specific surface in full (Arrow, bulk copy, native asyncio) and
the upstream-compatible entry points the Python layer calls. Statement and
connection handles are opaque to callers; the Python layer owns them.
"""

from typing import Any, Dict, Iterable, List, Optional, Sequence, Tuple

__version__: str
__architecture__: str
ARCHITECTURE: str
__rust_port__: bool
SQL_NO_TOTAL: int

# ---------------------------------------------------------------------------
# Arrow (Arrow PyCapsule interface; no pyarrow needed)
# ---------------------------------------------------------------------------

class ArrowTable:
    """A fully fetched result. Zero-copy for any Arrow consumer."""

    @property
    def num_rows(self) -> int: ...
    @property
    def num_columns(self) -> int: ...
    @property
    def num_batches(self) -> int: ...
    @property
    def column_names(self) -> List[str]: ...
    def __len__(self) -> int: ...
    def __arrow_c_schema__(self) -> Any: ...
    def __arrow_c_stream__(self, requested_schema: Optional[Any] = None) -> Any: ...
    @staticmethod
    def concat(tables: Sequence["ArrowTable"]) -> "ArrowTable": ...

class ArrowStream:
    """A result being streamed as Arrow record batches (one-shot)."""

    @property
    def num_columns(self) -> int: ...
    @property
    def column_names(self) -> List[str]: ...
    @property
    def closed(self) -> bool: ...
    def __arrow_c_schema__(self) -> Any: ...
    def __arrow_c_stream__(self, requested_schema: Optional[Any] = None) -> Any: ...
    def read_all(self) -> ArrowTable: ...
    def close(self) -> None: ...

class AgentRender:
    """Collects the bounded text output of one statement (see arrowsql.agent)."""

    def __init__(
        self,
        format: str = "tsv",
        max_bytes: int = 10000,
        max_rows: int = 1000,
        max_cell_chars: int = 500,
        tail_rows: int = 0,
        timeout_s: Optional[float] = None,
    ) -> None: ...
    def has_room(self) -> bool: ...
    def result_set(
        self, statement: Any, messages: Optional[List[Any]] = None
    ) -> Tuple[int, bool]: ...
    def rows_affected(self, count: int) -> None: ...
    def message(self, text: str) -> None: ...
    def omit(self, count: int) -> None: ...
    def finish(self) -> str: ...

def DDBCArrowFetchTable(
    statement: Any,
    max_rows: int = -1,
    batch_size: int = 65536,
    messages: Optional[List[Any]] = None,
